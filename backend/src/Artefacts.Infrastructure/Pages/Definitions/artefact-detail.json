{
  "name": "Artefact",
  "root": {
    "type": "container",
    "id": "artefact",
    "dataSource": {
      "kind": "query",
      "queryId": "artefact-detail",
      "variables": {
        "id": {
          "from": "route",
          "name": "id"
        }
      },
      "require": "artefact"
    },
    "children": [
      {
        "type": "layout",
        "id": "page",
        "layout": "stack",
        "children": [
          {
            "type": "widget",
            "id": "actions",
            "widgetId": "record-actions",
            "bindings": {
              "id": "artefact.id"
            },
            "config": {
              "actions": [
                {
                  "label": "All artefacts",
                  "href": "/artefacts",
                  "icon": "back"
                },
                {
                  "label": "Print",
                  "href": "/artefacts/{id}/print",
                  "icon": "print"
                },
                {
                  "label": "Edit",
                  "href": "/artefacts/{id}/edit",
                  "icon": "edit",
                  "primary": true
                }
              ]
            }
          },
          {
            "type": "layout",
            "id": "head",
            "layout": "row",
            "children": [
              {
                "type": "widget",
                "id": "title",
                "widgetId": "heading",
                "bindings": {
                  "text": "artefact.title",
                  "subtitle": "artefact.maker"
                }
              },
              {
                "type": "widget",
                "id": "tag",
                "widgetId": "inventory-tag",
                "bindings": {
                  "text": "artefact.inventoryNumber"
                }
              }
            ]
          },
          {
            "type": "layout",
            "id": "body",
            "layout": "split",
            "children": [
              {
                "type": "widget",
                "id": "gallery",
                "widgetId": "image-gallery",
                "bindings": {
                  "images": "artefact.images[]"
                },
                "config": {
                  "emptyText": "No images yet. Add them from Edit."
                }
              },
              {
                "type": "layout",
                "id": "facts",
                "layout": "stack",
                "children": [
                  {
                    "type": "layout",
                    "id": "catalogue",
                    "layout": "section",
                    "title": "Catalogue",
                    "children": [
                      {
                        "type": "widget",
                        "id": "catalogue-fields",
                        "widgetId": "field-list",
                        "bindings": {
                          "inventoryNumber": "artefact.inventoryNumber",
                          "maker": "artefact.maker",
                          "creationDate": "artefact.creationDate",
                          "medium": "artefact.medium",
                          "dimensions": "artefact.dimensions"
                        },
                        "config": {
                          "labels": {
                            "inventoryNumber": "Inventory no.",
                            "maker": "Maker",
                            "creationDate": "Date",
                            "medium": "Medium",
                            "dimensions": "Dimensions"
                          }
                        }
                      },
                      {
                        "type": "widget",
                        "id": "description",
                        "widgetId": "translated-text",
                        "bindings": {
                          "text": "artefact.description",
                          "language": "artefact.descriptionLanguage",
                          "requested": "language"
                        }
                      }
                    ]
                  },
                  {
                    "type": "layout",
                    "id": "classification",
                    "layout": "section",
                    "title": "Classification and origin",
                    "children": [
                      {
                        "type": "widget",
                        "id": "classification-fields",
                        "widgetId": "field-list",
                        "bindings": {
                          "objectType": "artefact.objectType.name",
                          "collectionGroup": "artefact.collectionGroup.name",
                          "place": "artefact.placeOfProduction.text",
                          "region": "artefact.placeOfProduction.region.name",
                          "dynasty": "artefact.dynasty.name"
                        },
                        "config": {
                          "labels": {
                            "objectType": "Object type",
                            "collectionGroup": "Group",
                            "place": "Place of production",
                            "region": "Region",
                            "dynasty": "Dynasty or period"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "layout",
                    "id": "holding",
                    "layout": "section",
                    "title": "Holding",
                    "children": [
                      {
                        "type": "widget",
                        "id": "holding-fields",
                        "widgetId": "field-list",
                        "bindings": {
                          "holder": "artefact.holder.name",
                          "storageLocation": "artefact.storageLocation.name",
                          "valuation": "artefact.valuation"
                        },
                        "config": {
                          "labels": {
                            "holder": "Holder",
                            "storageLocation": "Storage location",
                            "valuation": "Valuation"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "layout",
                    "id": "acquisition",
                    "layout": "section",
                    "title": "Acquisition",
                    "children": [
                      {
                        "type": "widget",
                        "id": "acquisition-fields",
                        "widgetId": "field-list",
                        "bindings": {
                          "method": "artefact.acquisition.method",
                          "date": "artefact.acquisition.date",
                          "source": "artefact.acquisition.source.name",
                          "lot": "artefact.acquisition.lot",
                          "price": "artefact.acquisition.price"
                        },
                        "config": {
                          "labels": {
                            "method": "Method",
                            "date": "Date",
                            "source": "Source",
                            "lot": "Lot",
                            "price": "Price"
                          }
                        }
                      },
                      {
                        "type": "widget",
                        "id": "acquisition-note",
                        "widgetId": "text-block",
                        "bindings": {
                          "text": "artefact.acquisition.note"
                        }
                      }
                    ]
                  },
                  {
                    "type": "layout",
                    "id": "provenance",
                    "layout": "section",
                    "title": "Provenance",
                    "children": [
                      {
                        "type": "repeat",
                        "id": "provenance-steps",
                        "itemsPath": "artefact.provenance[]",
                        "layout": "steps",
                        "emptyText": "No provenance recorded.",
                        "children": [
                          {
                            "type": "widget",
                            "id": "step",
                            "widgetId": "list-row",
                            "bindings": {
                              "primary": "region.name",
                              "secondary": "period",
                              "note": "note"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "layout",
                    "id": "exhibitions",
                    "layout": "section",
                    "title": "Exhibitions",
                    "children": [
                      {
                        "type": "widget",
                        "id": "exhibition-list",
                        "widgetId": "text-list",
                        "bindings": {
                          "items": "artefact.exhibitions[]"
                        }
                      }
                    ]
                  },
                  {
                    "type": "layout",
                    "id": "catalogue-entry",
                    "layout": "section",
                    "title": "Catalogue entry",
                    "children": [
                      {
                        "type": "widget",
                        "id": "catalogue-entry-text",
                        "widgetId": "translated-text",
                        "bindings": {
                          "text": "artefact.catalogueEntry",
                          "language": "artefact.catalogueEntryLanguage",
                          "requested": "language"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
