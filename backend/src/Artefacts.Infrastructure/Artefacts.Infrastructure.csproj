<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Artefacts.Application\Artefacts.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.1.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.6" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="16.7.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Hot Chocolate's global usings clash with domain names (ObjectType); its namespaces are imported where used. -->
    <HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Read\Views\*.sql" LogicalName="Views.%(Filename).sql" />
    <EmbeddedResource Include="Graph\Queries\*.graphql" LogicalName="Queries.%(Filename).graphql" />
    <EmbeddedResource Include="Pages\Definitions\*.json" LogicalName="Pages.%(Filename).json" />
  </ItemGroup>

</Project>
