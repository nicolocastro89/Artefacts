# Development-only settings for docker compose. Copy to `.env` to override.
# Every value has a default in docker-compose.yml, so `.env` is optional.

POSTGRES_USER=artefacts
POSTGRES_PASSWORD=artefacts
POSTGRES_DB=artefacts
POSTGRES_PORT=5432

# Must match docker/seaweedfs/s3.json
S3_ACCESS_KEY=artefacts-dev
S3_SECRET_KEY=artefacts-dev-secret
S3_BUCKET=artefacts-media
S3_PORT=8333

# imgproxy URL signing (hex). The API must use the same values (Imgproxy:Key / Imgproxy:Salt).
# These are development values only; generate new ones for any shared environment.
IMGPROXY_KEY=a86d03b9cbd7d9ada5a11a4966fbc20cdad396f26455f70b17a79a366211b701
IMGPROXY_SALT=00899ee009d3ca5365ba6b27f2ed185720037e63ea019ff17a56a786901ac3bb
IMGPROXY_PORT=8080
